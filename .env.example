# Environment variables for Vercel deployment

# 1. PostgreSQL Database URL (e.g. from Neon.tech or Supabase)
DATABASE_URL="postgresql://username:password@ep-example-123456.asia-southeast1.aws.neon.tech/neondb?sslmode=require"

# 2. Secret key for user session cookies
SESSION_SECRET="your-random-session-secret-key-here"

# 3. Gemini API Key for Invoice OCR (Free key from https://aistudio.google.com)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
