# Environment variables for Vercel deployment

# 1. PostgreSQL Database URL (e.g. from Neon.tech or Supabase)
DATABASE_URL="postgresql://username:password@ep-example-123456.asia-southeast1.aws.neon.tech/neondb?sslmode=require"

# 2. Secret key for user session cookies
SESSION_SECRET="your-random-session-secret-key-here"

# 3. Gemini API Key for Invoice OCR — primary provider (Free: https://aistudio.google.com)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 4. OpenAI API Key — fallback if Gemini quota is exceeded (Free credits: https://platform.openai.com)
#    Used automatically when Gemini returns 429. Set EITHER or BOTH.
OPENAI_API_KEY="sk-YourOpenAIKeyHere"

# 5. Mistral API Key — free tier fallback, no credit card required (https://console.mistral.ai)
#    Uses pixtral-12b vision model. Set this if both Gemini and OpenAI are unavailable.
MISTRAL_API_KEY="YourMistralKeyHere"
