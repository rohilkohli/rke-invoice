generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  QUOTATION
}

enum SignatureType {
  DRAWN
  UPLOADED
  TYPED
}

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNo       String
  invoiceDate     DateTime
  poNo            String?
  referenceNo      String?
  referenceDate    String?
  buyerOrderNo     String?
  paymentTerms     String?
  termsOfDelivery  String?

  billPeriodStart DateTime?
  billPeriodEnd   DateTime?

  state           String
  stateCode       String
  transportMode   String?
  vehicleNo       String?
  placeOfSupply   String?

  status          InvoiceStatus @default(DRAFT)
  reverseCharge   Boolean       @default(false)

  cgstRate        Decimal       @default(9)
  sgstRate        Decimal       @default(9)
  igstRate        Decimal       @default(18)

  irn             String?
  ewayBillNo      String?

  totalBeforeTax  Decimal       @default(0)
  cgst            Decimal       @default(0)
  sgst            Decimal       @default(0)
  igst            Decimal       @default(0)
  grandTotal      Decimal       @default(0)
  amountInWords   String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Legacy: PDFs are made on demand now and this copy is no longer written or read.
  // The Prisma client leaves pdfData out of every query (see lib/db.ts).
  pdfName         String?
  pdfData         String?

  userId          Int?
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId        Int
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // Bill-to and ship-to exactly as they were when this invoice was last saved, so changing
  // or re-using a client never alters an invoice that was already issued. Invoices saved
  // before these columns existed have them empty and fall back to the linked client.
  clientName      String?
  clientAddress   String?
  clientGstin     String?
  clientState     String?
  clientStateCode String?
  shipToName      String?
  shipToAddress   String?
  shipToGstin     String?
  shipToState     String?
  shipToStateCode String?

  // What was last sent to Google Drive, so renamed or deleted invoices can be cleaned up there.
  driveSyncedNo   String?
  driveSyncedYear String?
  driveSyncedFile String?
  driveSyncedAt   DateTime?
  driveSyncError  String?

  lineItems       LineItem[]
  signature       Signature?

  @@unique([userId, invoiceNo])
  @@index([invoiceDate])
  @@index([clientId])
}

model Client {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  address       String
  gstin         String
  state         String
  stateCode     String
  shipToName    String?
  shipToAddress String?
  shipToGstin   String?
  shipToState   String?
  shipToStateCode String?

  invoices      Invoice[]
  payments      Payment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([name])
  @@index([gstin])
  @@index([userId])
}

model LineItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sno         Int
  description String
  hsnSac      String?

  // Unit, Qty and Rate are free text, printed exactly as typed. Nothing is calculated from them.
  unit        String
  qty         String   @default("")
  rate        String   @default("")
  // Typed in by the user; the only line figure that feeds the invoice totals.
  amount      Decimal  @default(0)

  equipmentId Int?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  meterStart  Decimal?
  meterEnd    Decimal?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([invoiceId, sno])
  @@index([invoiceId])
}

model CompanySettings {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  gstin            String
  address          String
  email            String?
  phone            String?

  bankName         String?
  branch           String?
  accountNo        String?
  ifsc             String?
  upiId            String?
  tagline          String?
  accountType      String?  @default("Current")
  stateCode        String?
  state            String?

  logoUrl          String?
  signatureUrl     String?
  invoicePrefix    String?

  defaultCgstRate  Decimal  @default(9)
  defaultSgstRate  Decimal  @default(9)
  defaultIgstRate  Decimal  @default(18)

  termsAndConditions String?

  gdriveWebhookUrl   String?
  // Shared secret the Apps Script checks on every request. Never sent to the browser.
  gdriveWebhookSecret String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Signature {
  id        Int           @id @default(autoincrement())
  invoiceId Int           @unique
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  dataUrl   String
  type      SignatureType

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model User {
  id              Int               @id @default(autoincrement())
  email           String            @unique
  password        String
  name            String?
  invoices        Invoice[]
  payments        Payment[]
  clients         Client[]
  companySettings CompanySettings[]
  equipment       Equipment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Payment {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Decimal
  referenceNo String?  // e.g. UTR / Bank Reference No / Cash
  description String?  // e.g. Remarks / Details
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
}

model Equipment {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  serialNo  String?
  status    String     @default("AVAILABLE") // AVAILABLE, RENTED, MAINTENANCE

  lineItems LineItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}
